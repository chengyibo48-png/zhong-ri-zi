extends RefCounted
## Canonical native snapshot; disk IO and validation stay separate.
static func capture(state: Node) -> Dictionary:
	state._sync_farm_beds_from_plots()
	state._museum_sync()
	var fishing: Dictionary=state.fishing.duplicate(true)
	fishing.queue=[]
	return {
		"version": 33,
		"player_name": state.player_name,
		"player_gender": state.player_gender,
		"day": state.day,
		"minutes": state.minutes,
		"stamina": state.stamina,
		"money": state.money,
		"player": {"x": state.player_source_position.x, "y": state.player_source_position.y, "direction": state.player_direction},
		"interior": state.current_interior,
		"riding": state.riding,
		"interior_position": state.interior_source_position.duplicate(),
		"interior_return_position": state.interior_return_source.duplicate(true) if state.interior_return_source is Dictionary else null,
		"interior_state": state.interior_state,
		"letters": state.letters,
		"mail_read": state.mail_read,
		"selected_tool": state.selected_tool,
		"selected_seed": state.selected_seed,
		"selected_recipe": state.selected_recipe,
		"inventory": state.inventory,
		"storage": state.storage,
		"plots": state.plots,
		"quality": state.quality,
		"storage_quality": state.storage_quality,
		"economy": state.economy,
		"environment": state.environment,
		"forage": state.forage,
		"fishing": fishing,
		"quests": state.quests.duplicate(true),
		"kitchen": state.kitchen,
		"legacy_processing": state.legacy_processing,
		"toolkit": state.toolkit,
		"skills": state.skills,
		"community_projects": state.community_projects,
		"legacy_chapters": state.legacy_chapters,
		"year_plans": state.year_plans,
		"achievements": state.achievements,
		"farm": state.farm,
		"building": state.building,
		"known_recipes": state.known_recipes,
		"ranch": state.ranch,
		"selected_animal_action": state.selected_animal_action,
		"animals": state.animals,
		"upgrades": state.upgrades,
		"relations": state.relations,
		"neighbors": state.neighbors,
		"npc_residents": state.npc_residents,
		"last_gifts": state.last_gifts,
		"npc_stories": state.npc_stories,
		"partners": state.partners,
		"marriage": state.marriage,
		"collection": state.collection,
		"atlas": state.atlas,
		"archives": state.archives,
		"furniture": state.furniture,
		"pet": state.pet_state,
		"festivals": state.festivals,
		"season_events": state.season_events,
		"flags": state.flags,
		"gathered": state.gathered,
		"fish_caught": state.fish_caught,
		"player_settings": state.player_settings,
		"visual_fx": state.visual_fx,
		"ui_art": state.ui_art,
		"appearance": state.appearance,
		"feedback": state.feedback,
		"player_stats": state.player_stats,
		"player_journal": state.player_journal,
		"legacy_systems": state.legacy_systems,
		"legacy_archive": state.legacy_archive
	}
