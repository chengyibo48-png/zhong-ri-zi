extends "res://tools/ui_quest_gpu.gd"
func run() -> void:
	create_timer(70,true,false,true).timeout.connect(func():quit(1))
	s=root.get_node("GameState");s.set_process(false);s.flags.introDone=true;s.ui_open=false;s.current_interior="";root.size=Vector2i(960,600)
	change_scene_to_file("res://scenes/main.tscn");await settle();w=current_scene;w.player.set_physics_process(false);Input.warp_mouse(Vector2(1,1));w.hud.hover_card.hide()
	s.changed.emit();await capture("after-hud")
	await open("menu");validate("final-menu");await capture("after-menu")
	await open("tasks");validate("final-tasks");await capture("after-tasks")
	await open("bag");validate("final-bag");await capture("after-bag")
	w.hud.ui_stack.leave();s.select_toolbar_tool("water");w.hud.life_plan_panel.open_panel("guide:home:bag");await settle()
	var action: Button=w.hud.life_plan_panel.action_dock.get_child(0)
	action.pressed.emit();action.pressed.emit();await settle()
	check(str(w.hud.life_plan_panel.selected_id)=="guide:home:tools","acknowledging advances to the next chain step")
	check(str(s.quests.entries["guide:home:tools"].status)!="completed","double callback stays bound to its original quest")
	w.hud.ui_stack.leave();w.hud.show_farm_planner(false,0);w.hud.close_top_panel();w.hud.farm_facility_panel.open_panel(false,0);w.hud.close_top_panel();await settle()
	check(not s.ui_open and w.hud.ui_stack.active()==null,"explicitly closed consecutive pages do not reopen and cancel subsequent work")
	w.hud.show_life_menu();w.hud.life_menu._choose("plans");await settle();w.hud.close_top_panel();await settle()
	check(w.hud.life_menu.visible and s.ui_open,"menu navigation retains a real parent page")
	w.hud.ui_stack.leave()
	w.hud.life_plan_panel.open_panel();await settle()
	var remembered: Button=w.hud.life_plan_panel.action_dock.get_child(0);var remembered_text: String=remembered.text;remembered.grab_focus()
	w.hud.show_museum("catalog","item:cabbage");await settle();w.hud.close_top_panel();await settle()
	var focus: Control=root.gui_get_focus_owner()
	check(focus is BaseButton and focus.text==remembered_text,"detail return restores semantic focus after source buttons rebuild")
	w.hud.ui_stack.leave()
	var f:=FileAccess.open("res://artifacts/ui-quests-20261017/final-capture-report.json",FileAccess.WRITE);f.store_string(JSON.stringify({"passed":passed,"failed":failed,"screenshots":screens},"  "))
	print("UI final capture: %d passed, %d failed" % [passed,failed]);await root.get_node("AudioService").prepare_exit();quit(1 if failed>0 else 0)
